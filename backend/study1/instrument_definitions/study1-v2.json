      "items": [
        {"item_id": "candidate_id", "prompt": "Select one candidate.", "response_type": "text", "constraints": {"max_length": 128}, "required": true},
        {"item_id": "rationale", "prompt": "Explain your judgment.", "response_type": "text", "constraints": {"max_length": 4000}, "required": true},
        {"item_id": "confidence", "prompt": "Rate your confidence.", "response_type": "integer", "constraints": {"min": 1, "max": 7}, "required": true}
      ]
    },
    {
      "instrument_definition_id": "tentative-individual-v2",
      "instrument_version": "2.0",
      "phase": "TENTATIVE_DECISION",
