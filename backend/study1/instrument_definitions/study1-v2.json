        {"item_id": "proxy_trust", "prompt": "Rate trust in the Proxy process.", "response_type": "integer", "constraints": {"min": 1, "max": 7}, "required": true},
        {"item_id": "team_synchronization", "prompt": "Rate team synchronization.", "response_type": "integer", "constraints": {"min": 1, "max": 7}, "required": true},
        {"item_id": "comments", "prompt": "Add any comments.", "response_type": "text", "constraints": {"max_length": 4000}, "required": false}
      ]
    }
  ]
