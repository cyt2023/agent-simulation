        {"item_id": "rationale", "prompt": "Explain the tentative decision.", "response_type": "text", "constraints": {"max_length": 4000}, "required": true},
        {"item_id": "confidence", "prompt": "Rate your confidence.", "response_type": "integer", "constraints": {"min": 1, "max": 7}, "required": true},
        {"item_id": "decision_status", "prompt": "Describe the decision status.", "response_type": "enum", "constraints": {"values": ["open", "tentative", "settled"]}, "required": true}
      ]
    },
    {
