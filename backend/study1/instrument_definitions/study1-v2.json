        {"item_id": "member_positions", "prompt": "Describe T1, T2, and X positions separately.", "response_type": "text", "constraints": {"max_length": 4000}, "required": true},
        {"item_id": "disagreements", "prompt": "What disagreements or unresolved issues remain?", "response_type": "text", "constraints": {"max_length": 4000}, "required": true},
        {"item_id": "decision_status", "prompt": "Is the result a suggestion, tentative consensus, final commitment, or unresolved?", "response_type": "enum", "constraints": {"values": ["suggestion", "tentative_consensus", "final_commitment", "unresolved"]}, "required": true},
        {"item_id": "proxy_commitments", "prompt": "What commitments, if any, did X make?", "response_type": "text", "constraints": {"max_length": 4000}, "required": true},
        {"item_id": "acceptance_intention", "prompt": "What do you intend to accept, reject, or revise?", "response_type": "text", "constraints": {"max_length": 4000}, "required": true},
        {"item_id": "confidence", "prompt": "Confidence in your understanding.", "response_type": "integer", "constraints": {"min": 1, "max": 7}, "required": true}
      ]
    },
    {
      "instrument_definition_id": "final-individual-v2",
      "instrument_version": "2.0",
      "phase": "FINAL_DECISION",
      "applicable_roles": ["principal", "teammate_1", "teammate_2"],
      "items": [
        {"item_id": "candidate_id", "prompt": "Select your final candidate.", "response_type": "text", "constraints": {"max_length": 128}, "required": true},
        {"item_id": "rationale", "prompt": "Explain your final judgment.", "response_type": "text", "constraints": {"max_length": 4000}, "required": true},
        {"item_id": "confidence", "prompt": "Rate your confidence.", "response_type": "integer", "constraints": {"min": 1, "max": 7}, "required": true}
      ]
    },
    {
      "instrument_definition_id": "post-survey-v2",
      "instrument_version": "2.0",
