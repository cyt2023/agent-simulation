        {"item_id": "expected_tentative_agreement", "prompt": "What, if anything, may X tentatively agree to?", "response_type": "text", "constraints": {"max_length": 4000}, "required": true},
        {"item_id": "confidence", "prompt": "Confidence in these expectations.", "response_type": "integer", "constraints": {"min": 1, "max": 7}, "required": true}
      ]
    },
    {
      "instrument_definition_id": "comprehension-measurement-v2",
